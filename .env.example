# Copy to .env.local for `vercel dev`, or set these in your host's dashboard.

# Required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — model id. Default is gemini-2.5-flash. If the /api/chat response
# says the model was not found, set this to a current id.
GEMINI_MODEL=gemini-2.5-flash

# Optional — comma-separated origin allowlist for the proxy. Default "*".
# e.g. ALLOWED_ORIGINS=https://sahil-terminators.github.io,https://admindly.example.com
ALLOWED_ORIGINS=*
