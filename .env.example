# Copy to .env.local for `vercel dev`, or set these in your host's dashboard.
# Everything degrades gracefully — with nothing set, the site works static
# (scripted chat, sample metrics). Add creds per feature.

# ── Creative Copilot (Gemini) ───────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash          # if "model not found", set a current id
GEMINI_THINKING_BUDGET=128             # Gemini-3 thinking tokens; -1 to omit

# ── Token store for the social integrations (Upstash Redis REST) ─────────
# https://upstash.com → create a Redis DB (free) → REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Monitoring · Instagram (Instagram API with Instagram Login) ──────────
# Meta app → Instagram → API setup with Instagram login → Business login settings
IG_APP_ID=
IG_APP_SECRET=

# ── Monitoring · Facebook (Pages API, needs a Facebook Page) ─────────────
# Meta app → Settings → Basic  (same app is fine)
META_APP_ID=
META_APP_SECRET=

# ── Google (Sign-in with Google  +  YouTube monitoring) ────────────────
# One OAuth client (Web) covers both. Add BOTH redirect URIs to it:
#   https://<host>/api/login/google/callback     (sign-in)
#   https://<host>/api/auth/youtube/callback      (YouTube data)
# For YouTube data also enable: "YouTube Data API v3" + "YouTube Analytics API"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Monitoring · TikTok (Login Kit + Display API) ──────────────────────
# developers.tiktok.com → your app → credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Optional ───────────────────────────────────────────────────────────
# Per-provider redirect override (default https://<host>/api/auth/<provider>/callback)
# IG_REDIRECT_URI=  META_REDIRECT_URI=  GOOGLE_REDIRECT_URI=  TIKTOK_REDIRECT_URI=
ALLOWED_ORIGINS=*
