# Copy to .env.local for `vercel dev`, or set these in your host's dashboard.

# ── Creative Copilot (Gemini) ───────────────────────────────────────────
# Required for the live chat. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — model id. Default gemini-3.6-flash. If /api/chat says
# "model not found" / "no longer available", set this to a current id.
GEMINI_MODEL=gemini-3.6-flash
# Optional — thinking budget for Gemini 3 (tokens). 128 = fast. Set -1 to omit.
GEMINI_THINKING_BUDGET=128

# ── Monitoring (Instagram) ──────────────────────────────────────────────
# From: developers.facebook.com → your app → Instagram → Business login settings
IG_APP_ID=
IG_APP_SECRET=
# Optional — override the OAuth redirect. Defaults to
# https://<deployed-host>/api/auth/instagram/callback  (must match the value
# registered in the Meta app exactly).
IG_REDIRECT_URI=

# Token store (Upstash Redis REST — https://upstash.com, free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Shared ─────────────────────────────────────────────────────────────
# Optional — comma-separated origin allowlist for the API. Default "*".
ALLOWED_ORIGINS=*
